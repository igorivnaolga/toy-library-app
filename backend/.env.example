# Supabase Postgres: Settings -> Database -> Connection string -> URI
# On Windows / IPv4-only networks, do NOT use db.<project>.supabase.co (IPv6-only).
# Use the **Session pooler** URI and keep the postgresql+psycopg:// prefix, e.g.:
# postgresql+psycopg://postgres.<project-ref>:YOUR_PASSWORD@aws-0-<region>.pooler.supabase.com:5432/postgres
# Leave empty for catalog-only local dev (CSV fallback; bookings/loans need a DB).
DATABASE_URL=
# Schema: run `alembic upgrade head` from backend/ (the API never creates tables).
# Shared secret for POST /api/v1/admin/notifications/send-member-reminders/cron
# (GitHub Actions sends header X-Cron-Secret). Use a long random string.
CRON_SECRET=
# Optional: path to Firebase service account JSON for FCM push notifications.
# FIREBASE_CREDENTIALS_PATH=./firebase-service-account.json
JWT_SECRET=change-me
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
# Supabase (Auth + JWT verification in FastAPI). Dashboard → Settings → API.
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_JWT_SECRET=your-jwt-secret-from-supabase-api-settings
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here
# Server-side Supabase Storage uploads (Dashboard → Settings → API → service_role).
# When set with SUPABASE_URL, toy photos are stored in the toy-photos bucket instead of disk.
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# Optional bucket name (default: toy-photos)
# TOY_PHOTOS_BUCKET=toy-photos
# Comma-separated browser origins for Flutter web. Empty = browser CORS off.
# `http://localhost:*` allows any port on that host; `*` allows any site (dev only).
CORS_ORIGINS=http://localhost:*,http://127.0.0.1:*
# Serve /docs and /openapi.json (keep false in production).
EXPOSE_API_DOCS=true
# Folder containing JPG/PNG files named like `photo_file` in the API (e.g. 142928.jpg).
# If unset, the API uses `<repo>/toy_library_photos` when that directory exists.
# TOY_IMAGES_DIR=C:\path\to\toy_library_photos
